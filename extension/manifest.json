{
  "manifest_version": 3,
  "name": "Lookahead Subtitles for YouTube",
  "version": "0.1.0",
  "description": "Translate YouTube captions or locally recognized speech into your chosen language. Requires a local companion and ChatGPT access.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Lookahead Subtitles for YouTube",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page-probe.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "subtitle-languages.js",
        "queue-engine.js",
        "language-tracker.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "audio-worklet.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
